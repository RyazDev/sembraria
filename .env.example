# ====================================================================
# SembrarIA — Plantilla de variables de entorno
# Copiar este archivo a `.env` en la raiz del proyecto y completar:
#   cp .env.example .env
#
# NUNCA commitear el .env real al repositorio.
# ====================================================================

# === App ===
APP_ENV=development
APP_NAME=SembrarIA

# === Database ===
# Formato: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sembraria
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# === Security / JWT ===
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimo 32 caracteres en produccion.
JWT_SECRET=cambiar-en-produccion-usar-secrets-token-urlsafe-64
# Algoritmo: HS256 es suficiente para esta app. Para multi-region, usar RS256.
JWT_ALGORITHM=HS256
# Minutos hasta que un token expira (default 60 = 1 hora).
JWT_EXPIRE_HOURS=24

# --- Rotacion de claves ---
# Identificador de la clave activa (se incluye como `kid` en cada JWT).
JWT_KEY_ID=v1
# Clave ANTERIOR (llenada automaticamente por scripts/security/rotate_jwt_secret.py).
# Sirve para validar tokens emitidos antes de la rotacion durante el periodo de gracia.
# Dejar vacia en la primera instalacion.
PREVIOUS_JWT_SECRET=
PREVIOUS_JWT_KEY_ID=
# ISO 8601 de la ultima rotacion. Vacio = nunca rotada.
JWT_ROTATED_AT=
# Segundos durante los cuales la clave anterior sigue aceptando tokens.
# 86400 = 24h. 0 = invalidar todos los tokens al rotar.
JWT_GRACE_SECONDS=86400

# === Rasters ===
RASTER_INPUTS_DIR=./data/inputs
RASTER_OUTPUTS_DIR=./data/outputs

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === CORS (origenes del frontend permitidos, separados por coma) ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# === Notifications (mock por defecto) ===
# true = imprime en consola, false = envia SMTP/Twilio real
NOTIFICATIONS_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sembriaia.udla.edu.co
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# === Rate limiting ===
# Limite de requests por IP al endpoint /auth/login.
# 0 = sin limite (NO recomendado en produccion).
LOGIN_RATE_LIMIT_PER_MINUTE=10

# === Analysis ===
ANALYSIS_DEFAULT_CULTIVO=cacao
ANALYSIS_TIMEOUT_SECONDS=120
