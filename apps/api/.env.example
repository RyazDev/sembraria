# ====================================================================
# SembrarIA — Backend env vars
# Copy to .env (or to root .env) and fill values
# ====================================================================

# === App ===
APP_ENV=development
APP_NAME=SembrarIA

# === Database ===
# IMPORTANT: ajusta usuario, password y nombre de BD a tu instalación local.
# Por defecto se usa el superuser 'postgres' que crea el instalador de EDB.
# Para producción crea un usuario dedicado: CREATE USER sembraria WITH PASSWORD '...';
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sembraria
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# === Security ===
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# === Rasters ===
RASTER_INPUTS_DIR=./data/inputs
RASTER_OUTPUTS_DIR=./data/outputs

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Notifications ===
# true = log en consola (default), false = SMTP/Twilio real
NOTIFICATIONS_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sembriaia.udla.edu.co
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
